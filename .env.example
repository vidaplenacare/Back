DATABASE_URL="postgresql://vidaplena:vidaplena@localhost:5434/vidaplena?schema=public"
PORT=3000

AVISO_MINUTOS_ANTES=30
INICIO_COMPARTILHAMENTO_MINUTOS_ANTES=15

# Asaas (pagamentos). Chave de API do painel da Asaas (sandbox começa com $aact_) — só no backend,
# nunca no app. Sem ela, as rotas de pagamento/resgate respondem 503.
ASAAS_API_KEY=
# Sandbox por padrão; em produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token definido por nós ao cadastrar o webhook no painel da Asaas (vem no header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=
# Comissão da plataforma sobre cada visita, em % (ainda não definida — 0 = cuidador recebe tudo).
PLATAFORMA_COMISSAO_PERCENTUAL=0
